<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Padding for guidance content to move it away from the screen edge -->
    <dimen name="guidance_content_padding_start">48dp</dimen>
    <dimen name="guidance_content_padding_top">48dp</dimen>
    <dimen name="guidance_content_padding_bottom">48dp</dimen>

    <!-- Eliminate the gap between guidance and actions by removing the shadow width -->
    <dimen name="lb_guidedactions_section_shadow_width">0dp</dimen>

    <!--
      Sync the Leanback vertical guideline with the custom view_next_action guideline (0.58333333333).
      This ensures the background split happens at the exact same position on every page.
    -->
    <item name="lb_guidedstep_guideline" format="float" type="dimen">0.58333333333</item>
</resources>
